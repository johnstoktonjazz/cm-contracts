{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cm-contracts/geopackage/1.2.0",
  "title": "Геопакет проекта: слои, геометрия и поля",
  "version": "1.2.0",
  "description": "Описывает один файл <project>.gpkg в виде JSON-выгрузки (example.json). Как это лежит в самом GPKG — README, «Хранение». Проверяется скриптом картографа при каждой сборке.",
  "type": "object",
  "required": [
    "contract",
    "crs",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "geopackage/1.2.0"
    },
    "crs": {
      "type": "string",
      "description": "имя системы координат из project.yaml (crs.name): EPSG-код или МСК с зоной; одна на файл"
    },
    "project": {
      "type": "string",
      "description": "имя проекта из project.yaml"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "хэш входов сборки (файлы, правила, параметры); вместо времени сборки — повторная сборка дает тот же файл"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "geometry",
          "features"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "boundary_project",
              "boundary_planning",
              "red_lines",
              "blocks",
              "sites",
              "parcels",
              "buildings_cadastre",
              "zouit",
              "zones_pzz",
              "zones_genplan",
              "roads",
              "rail",
              "transit_stops",
              "buildings_osm",
              "green",
              "water",
              "poi_education",
              "poi_health",
              "poi_culture",
              "poi_hotels",
              "poi_other",
              "heritage",
              "accidents",
              "isochrones",
              "buffers",
              "concept_objects",
              "concept_sites"
            ],
            "description": "закрытый перечень; новый слой — новая версия контракта"
          },
          "geometry": {
            "type": "string",
            "enum": [
              "MultiPolygon",
              "MultiLineString",
              "Point"
            ],
            "description": "одна на слой, по перечню: площади — MultiPolygon, линии — MultiLineString, точки — Point"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/feature"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "boundary_project"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {}
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "boundary_planning"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {}
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "red_lines"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiLineString"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "existing",
                              "planned",
                              "cancelled"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "blocks"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "num": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "sites"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "num": {
                            "type": "string"
                          },
                          "purpose": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "parcels"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "cadastral_number": {
                            "type": "string"
                          },
                          "permitted_use": {
                            "type": "string"
                          },
                          "land_category": {
                            "type": "string"
                          },
                          "hazard_class": {
                            "type": "string",
                            "enum": [
                              "I",
                              "II",
                              "III",
                              "IV",
                              "V"
                            ],
                            "description": "класс опасности предприятия на участке (СЗЗ); вводит автор проекта"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "buildings_cadastre"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "cadastral_number": {
                            "type": "string"
                          },
                          "purpose": {
                            "type": "string"
                          },
                          "floors": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "zouit"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "zouit_type": {
                            "type": "string",
                            "enum": [
                              "sanitary",
                              "water_protection",
                              "coastal_strip",
                              "roadside",
                              "right_of_way",
                              "heritage_protection",
                              "airfield",
                              "utility_protection",
                              "other"
                            ]
                          },
                          "registry_number": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "zones_pzz"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "zone": {
                            "type": "string",
                            "enum": [
                              "Ж",
                              "ОЖ",
                              "ОД",
                              "П",
                              "ИТ",
                              "Р",
                              "СН",
                              "СХ"
                            ]
                          },
                          "code": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "zones_genplan"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "zone": {
                            "type": "string",
                            "enum": [
                              "Ж",
                              "ОЖ",
                              "ОД",
                              "П",
                              "ИТ",
                              "Р",
                              "СН",
                              "СХ"
                            ]
                          },
                          "code": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "roads"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiLineString"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "road_class": {
                            "type": "string",
                            "enum": [
                              "express",
                              "main",
                              "district",
                              "local",
                              "pedestrian",
                              "service",
                              "path"
                            ]
                          },
                          "tunnel": {
                            "type": "boolean"
                          },
                          "oneway": {
                            "type": "boolean",
                            "description": "одностороннее движение по направлению линии"
                          },
                          "bridge": {
                            "type": "boolean",
                            "description": "мост или путепровод: пересечение без перекрестка"
                          },
                          "road_category": {
                            "type": "string",
                            "enum": [
                              "IА",
                              "IБ",
                              "IВ",
                              "II",
                              "III",
                              "IV",
                              "V"
                            ],
                            "description": "категория автомобильной дороги (СП 34.13330: IА, IБ, IВ — кириллица, II–V) для придорожной полосы; вводит автор проекта, иначе — ASM соответствия класса улицы"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "rail"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiLineString"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "rail_class": {
                            "type": "string",
                            "enum": [
                              "main",
                              "siding",
                              "tram",
                              "subway"
                            ]
                          },
                          "tunnel": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "transit_stops"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "Point"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "bus",
                              "trolleybus",
                              "tram",
                              "rail",
                              "subway",
                              "ferry"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "buildings_osm"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "floors": {
                            "type": "integer"
                          },
                          "building_use": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "green"
                }
              }
            },
            "then": {
              "properties": {
                "geometry": {
                  "const": "MultiPolygon"
                },
                "features": {
                  "items": {
                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "green_class": {
                            "type": "string",
                            "enum": [
                              "park",
                              "forest",
                              "garden",
                              "cemetery",
                              "other"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
