                    "properties": {
                      "attrs": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "num": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "object_id",
        "kind",
        "status",
        "source_label",
        "source_date",
        "fact_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9._-]+$",
          "description": "устойчивый идентификатор «слой:ключ», ключ — из источника (README, «object_id»); уникален в файле"
        },
        "name": {
          "type": "string",
          "description": "название как в источнике; пусто для безымянных"
        },
        "kind": {
          "type": "string",
          "description": "тип объекта словами по словарю слоя (kinds.yaml)"
        },
        "status": {
          "type": "string",
          "enum": [
            "official",
            "cadastral",
            "digitized",
            "concept",
            "reference",
            "calc"
          ],
          "description": "статус геометрии; повышается только документом; calc — расчет картографа (изохрона, буфер) с CALC/NORM/ASM в fact_ids"
        },
        "source_doc": {
          "type": "string",
          "description": "идентификатор документа в реестре базы, если источник — документ проекта"
        },
        "source_label": {
          "type": "string",
          "minLength": 1,
          "description": "готовая подпись источника: документ и лист, номер выписки, имя внешнего источника"
        },
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$",
          "description": "дата документа или выгрузки: ГГГГ-ММ-ДД или ГГГГ-ММ"
        },
        "source_license": {
          "type": "string",
          "description": "лицензия внешнего источника (ODbL 1.0, CDLA-Permissive-2.0 …); обязательна у reference; у calc — если расчет от внешних данных, у расчета от документов проекта не пишется"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(F-[0-9]{6}|CALC-[0-9]{5}|NRM-[0-9]{5}|NORM-[0-9]{5}|ASM-[0-9]{4})$"
          },
          "description": "записи реестра базы, относящиеся к объекту; пустой список, если записей нет"
        },
        "attrs": {
          "type": "object",
          "description": "атрибуты слоя: закрытый перечень по слою, см. allOf"
        },
        "digitized_from": {
          "type": "string",
          "description": "обязательно при status=digitized: с какого документа или слайда, кем и когда"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "digitized"
              }
            }
          },
          "then": {
            "required": [
              "digitized_from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "source_license"
            ]
          }
        }
      ]
    }
  }
}
