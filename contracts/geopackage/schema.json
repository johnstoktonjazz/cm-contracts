                            "type": "string",
                            "enum": [
                              "sea",
                              "river",
                              "lake",
                              "reservoir",
                              "canal",
                              "other"
                            ]
                          },
                          "length_km": {
                            "type": "number",
                            "description": "длина водотока от истока до устья, км (водоохранная зона); вводит автор проекта или документ"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
